<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Chúc mừng ngày 20/10</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,600&family=Be+Vietnam+Pro:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg1:#fff5f8; --bg2:#ffd9e6; --ink:#6b1f3f; --soft:#a8587a; --card:rgba(255,255,255,.78); --line:#f7bfd3; --heart:#ff6f9f;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100vh;font-family:'Be Vietnam Pro',system-ui,sans-serif;color:var(--ink);
  background:linear-gradient(160deg,var(--bg1) 0%,#ffeaf1 45%,var(--bg2) 100%);background-color:var(--bg1);overflow-x:hidden}

/* Trái tim lơ lửng */
.hearts{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:0}
.heart{position:absolute;bottom:-40px;color:var(--heart);opacity:0;animation:floatUp linear infinite;will-change:transform,opacity}
@keyframes floatUp{
  0%{transform:translateY(0) translateX(0) rotate(-8deg);opacity:0}
  10%{opacity:.75}
  50%{transform:translateY(-55vh) translateX(24px) rotate(8deg)}
  90%{opacity:.5}
  100%{transform:translateY(-115vh)